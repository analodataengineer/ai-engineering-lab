{
  "name": "voice-interview-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "interfaces/web",
    "services/session-api",
    "engines/interview",
    "agents/interview-agent",
    "evals"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w interfaces/web",
    "dev:session-api": "npm run dev -w services/session-api",
    "dev:interview-engine": "npm run dev -w engines/interview",
    "eval": "npm run eval -w evals --",
    "eval:test": "npm run test -w evals"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@opentelemetry/sdk-node": "^0.205.0"
  }
}
